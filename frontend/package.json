{
  "name": "unifi-network-map-card",
  "version": "0.5.11",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/unifi-network-map.ts --bundle --format=esm --target=es2020 --define:__CARD_VERSION__=\\\"$npm_package_version\\\" --outfile=dist/unifi-network-map.js",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-util": "^30.2.0",
    "prettier": "3.9.9",
    "ts-jest": "29.4.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "test-exclude": "^8.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}
